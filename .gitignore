# Generated by the build pipeline — CI (deploy.yml) rebuilds this on every
# push and uploads it directly as the Pages artifact. Committing it would
# recreate the "which copy is live" ambiguity the old repo had.
dist/

# Generated Obsidian vault (create_graph.py output). Regenerate locally with
# `python src/pipeline/airport.py graph`. graph/.obsidian/ in particular is
# per-author Obsidian workspace state (open panes, plugin config), not
# project content.
graph/

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Node (no bundler is used, but editors/tools may still drop these)
node_modules/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/
